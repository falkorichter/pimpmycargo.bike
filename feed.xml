---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <link href="{{ '/' | absolute_url }}"/>
  <link rel="self" href="{{ '/feed.xml' | absolute_url }}"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/' | absolute_url }}</id>
  {% for post in site.posts limit: 30 %}
  <entry>
    <title>{{ post.title | strip_html | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}"/>
    <id>{{ post.url | absolute_url }}</id>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    {% assign img = post.thumb | absolute_url %}
    <content type="html">{% if post.thumb %}{{ '<img src="' | append: img | append: '">' | xml_escape }}{% endif %}{{ post.content | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
